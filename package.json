{
  "name": "jev-claudecode-ssy",
  "version": "1.0.1",
  "description": "One-command Jev context compaction for Claude Code through Shengsuanyun.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DM010727/jev-claudecode-ssy.git"
  },
  "homepage": "https://github.com/DM010727/jev-claudecode-ssy#readme",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "jev-claudecode-ssy": "./bin/setup.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && npm run typecheck:hooks",
    "test": "vitest run",
    "demo": "tsx examples/demo.ts",
    "typecheck:hooks": "tsc -p tsconfig.hooks.json",
    "validate:plugin": "claude plugin validate ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
